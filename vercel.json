{
  "functions": {
    "api/*.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/book", "destination": "/api/book" },
    { "source": "/demo", "destination": "/api/demo" }
  ],
  "crons": [
    { "path": "/api/summary", "schedule": "0 14 * * 1" },
    { "path": "/api/sweep", "schedule": "40 13 * * *" }
  ]
}
