# Copy to .env and fill in. Never commit .env.

# App
BASE_URL=https://your-app.vercel.app
DRY_RUN=true
DEMO_MODE=true
DEMO_INBOX=jainutsav67@gmail.com
CRM_PROVIDER=hubspot
NOTIFIER=slack
LINK_SECRET=

# Tally
TALLY_API_KEY=
TALLY_SIGNING_SECRET=

# Airtable (token scopes: data.records:read, data.records:write, schema.bases:read, schema.bases:write)
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=

# HubSpot (Service key)
HUBSPOT_TOKEN=

# LLM writer for the brief and emails: none | gemini | claude. Default none (template only).
LLM_PROVIDER=none

# Optional: only when LLM_PROVIDER=gemini (paid tier, billing linked)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Enrichment
CLAY_WEBHOOK_URL=
APOLLO_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
FULLENRICH_API_KEY=

# Optional: only when LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Google (Desktop OAuth client; refresh token from scripts/google-token.js)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Slack (bot token, xoxb-)
SLACK_BOT_TOKEN=

# Teams (optional, only when NOTIFIER=teams)
# TEAMS_WEBHOOK_AE=
# TEAMS_WEBHOOK_SDR=
# TEAMS_WEBHOOK_REVIEW=
# TEAMS_WEBHOOK_CS=
# TEAMS_WEBHOOK_REVOPS=
