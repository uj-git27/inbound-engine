# Copy to .env and fill in. Never commit .env.

# App
BASE_URL=https://your-app.vercel.app
DRY_RUN=true
DEMO_MODE=true
DEMO_INBOX=jainutsav67@gmail.com
CRM_PROVIDER=hubspot
NOTIFIER=slack
LINK_SECRET=

# Tally
# TALLY_FORM_URL: the public form link, used in emails ("rebook here", "grab time here").
TALLY_FORM_URL=https://tally.so/r/your-form-id
TALLY_API_KEY=
TALLY_SIGNING_SECRET=

# Airtable (token scopes: data.records:read, data.records:write, schema.bases:read, schema.bases:write)
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=

# HubSpot (Service key)
HUBSPOT_TOKEN=

# LLM writer for the brief and emails: none | gemini | claude. Default none (template only).
LLM_PROVIDER=none
# gemini: writes the 2 to 3 line summary of the dated signals (free tier is enough; no search is used).

# Optional: only when LLM_PROVIDER=gemini (paid tier, billing linked)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Enrichment
CLAY_WEBHOOK_URL=
APOLLO_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
FULLENRICH_API_KEY=

# Optional: only when LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Calendar and email through a normal mailbox, no Google Cloud needed.
# SMTP_HOST: smtp.zoho.in or smtp.zoho.com (Zoho personal), smtppro.zoho.in/.com (Zoho paid), smtp.gmail.com (Gmail).
# SMTP_USER: the full email address. SMTP_APP_PASSWORD: an app-specific password, not the login password.
# CALENDAR_ICAL_URL: the calendar's private iCal (.ics) address, used to see when you are busy.
SMTP_HOST=smtp.zoho.in
SMTP_USER=
SMTP_APP_PASSWORD=
CALENDAR_ICAL_URL=

# Optional alternative: Google API (Desktop OAuth client; refresh token from scripts/google-token.js).
# Used instead of the Gmail app password when GOOGLE_REFRESH_TOKEN is set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Slack (bot token, xoxb-)
SLACK_BOT_TOKEN=
# Optional: the app's Signing Secret. When set, alert actions are Slack buttons instead of links.
SLACK_SIGNING_SECRET=

# Teams (optional, only when NOTIFIER=teams)
# TEAMS_WEBHOOK_AE=
# TEAMS_WEBHOOK_SDR=
# TEAMS_WEBHOOK_REVIEW=
# TEAMS_WEBHOOK_CS=
# TEAMS_WEBHOOK_REVOPS=
